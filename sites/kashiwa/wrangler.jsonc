{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "co-place-kashiwa",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PMTILES",
      "bucket_name": "co-place-pmtiles",
      "remote": false
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
