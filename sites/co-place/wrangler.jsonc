{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "co-place-main",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
